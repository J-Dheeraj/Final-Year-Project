# Copy this file to .env and fill in your keys
# .env is gitignored — never commit it

ANTHROPIC_API_KEY=sk-ant-...
NVD_API_KEY=your-nvd-key-here
GITHUB_TOKEN=ghp_...

# Optional: AIxTech LLM gateway (--backend aixtech on the 5 claude_backend.py
# experiment scripts) - an Anthropic-API-compatible proxy authenticated with
# a bearer token instead of a raw ANTHROPIC_API_KEY. This is a separately
# keyed, team-scoped gateway - not every Claude model name available via
# ANTHROPIC_API_KEY/claude -p will be on this gateway's allowlist.
ANTHROPIC_AUTH_TOKEN=sk-...
ANTHROPIC_BASE_URL=https://your-gateway.example/
